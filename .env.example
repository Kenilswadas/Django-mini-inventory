# Django Secret Key (Generate a secure random string for production)
SECRET_KEY=django-insecure-change-this-in-production-demo-key

# Debug Mode: True for development, False for production
DEBUG=True

# Allowed Hosts (comma-separated): e.g. 127.0.0.1,localhost,yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost

# CORS Allowed Origins (comma-separated): e.g. http://localhost:5173,https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
